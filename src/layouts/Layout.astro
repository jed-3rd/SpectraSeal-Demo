---
interface Props {
  title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="SpectraSeal forensic watermarking demo — embed invisible, traceable metadata into images using DCT frequency embedding and Reed-Solomon error correction."
    />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body class="bg-gray-950 text-gray-100 min-h-screen flex flex-col">
    <nav class="border-b border-gray-800 bg-gray-950/80 backdrop-blur-sm sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <a
            href={`${base}/`}
            class="text-xl font-bold tracking-tight"
            style="color: #00e5ff;"
          >
            SpectraSeal
          </a>
          <div class="flex items-center gap-6">
            <a
              href={`${base}/`}
              class="text-sm text-gray-400 hover:text-gray-100 transition-colors"
            >
              Home
            </a>
            <a
              href={`${base}/encode`}
              class="text-sm text-gray-400 hover:text-gray-100 transition-colors"
            >
              Encode
            </a>
            <a
              href={`${base}/decode`}
              class="text-sm text-gray-400 hover:text-gray-100 transition-colors"
            >
              Decode
            </a>
          </div>
        </div>
      </div>
    </nav>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-gray-800 mt-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-sm text-gray-500">
          SpectraSeal Demo &middot; Forensic Watermarking
        </p>
        <a
          href="https://github.com/jed-3rd/SpectraSeal-Demo"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-gray-500 hover:text-gray-300 transition-colors"
        >
          GitHub &rarr;
        </a>
      </div>
    </footer>
  </body>
</html>

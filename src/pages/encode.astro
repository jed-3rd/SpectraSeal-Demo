---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Encode Image — SpectraSeal">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="mb-10">
      <h1 class="text-4xl font-extrabold tracking-tight mb-3">Encode a Watermark</h1>
      <p class="text-gray-400">
        Upload an image and attach a label. SpectraSeal will invisibly embed your identity,
        IP, geolocation, and timestamp into the image using DCT frequency encoding.
      </p>
    </div>

    <!-- Wake-up Banner (hidden by default) -->
    <div
      id="wakeup-banner"
      class="hidden bg-gray-900 border border-[#00e5ff] rounded-xl px-5 py-4 mb-8 flex items-center gap-3"
    >
      <svg class="animate-spin h-4 w-4 shrink-0" style="color: #00e5ff;" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
      </svg>
      <span class="text-sm" style="color: #00e5ff;">Waking up server &mdash; this may take up to 60 seconds on first visit&hellip;</span>
    </div>

    <!-- Usage Counter -->
    <div
      id="usage-banner"
      class="bg-gray-900 border border-gray-800 rounded-xl px-5 py-4 mb-8 flex items-center justify-between"
    >
      <span class="text-sm text-gray-400">Monthly usage (encode + decode)</span>
      <span id="usage-text" class="text-sm font-semibold text-gray-200">Loading&hellip;</span>
    </div>

    <!-- Limit Reached Banner (hidden by default) -->
    <div
      id="limit-banner"
      class="hidden bg-amber-950/40 border border-amber-800 rounded-xl px-5 py-4 mb-8"
    >
      <p class="text-amber-400 text-sm font-semibold mb-1">Monthly limit reached</p>
      <p id="limit-reset-text" class="text-amber-500/80 text-xs">
        Your 5 encodes for this month have been used. Resets at the start of next month.
      </p>
    </div>

    <!-- Form -->
    <div class="bg-gray-900 border border-gray-800 rounded-2xl p-6 sm:p-8 space-y-6">
      <!-- Drop Zone -->
      <div>
        <label class="block text-sm font-medium text-gray-300 mb-2">Image File</label>
        <div
          id="drop-zone"
          class="border-2 border-dashed border-gray-700 hover:border-[#00e5ff] rounded-xl p-8 text-center cursor-pointer transition-colors"
        >
          <input
            id="file-input"
            type="file"
            accept="image/jpeg,image/png,image/webp"
            class="hidden"
          />
          <div id="drop-idle" class="pointer-events-none">
            <div class="text-4xl mb-3 text-gray-600">&#128444;</div>
            <p class="text-gray-400 text-sm mb-1">
              Drag &amp; drop your image here, or <span style="color: #00e5ff;">click to browse</span>
            </p>
            <p class="text-gray-600 text-xs">JPEG, PNG, WebP &mdash; max 20 MB</p>
          </div>
          <div id="drop-selected" class="hidden pointer-events-none">
            <div class="text-4xl mb-3" style="color: #00e5ff;">&#10003;</div>
            <p id="file-name" class="text-gray-200 text-sm font-medium mb-1"></p>
            <p class="text-gray-500 text-xs">Click to change file</p>
          </div>
        </div>
      </div>

      <!-- Label Input -->
      <div>
        <label for="label-input" class="block text-sm font-medium text-gray-300 mb-2">
          Your Label
          <span class="text-gray-500 font-normal ml-1">(optional)</span>
        </label>
        <div class="relative">
          <input
            id="label-input"
            type="text"
            maxlength="32"
            placeholder="e.g. Confidential Report Q1"
            class="w-full bg-gray-800 border border-gray-700 focus:border-[#00e5ff] outline-none rounded-lg px-4 py-3 text-sm text-gray-100 placeholder-gray-600 transition-colors pr-16"
          />
          <span
            id="char-count"
            class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-gray-600 pointer-events-none"
          >0 / 32</span>
        </div>
      </div>

      <!-- Submit Button -->
      <button
        id="encode-btn"
        disabled
        class="w-full bg-[#00e5ff] text-gray-950 font-semibold hover:bg-cyan-300 rounded-lg px-6 py-3 transition-colors opacity-40 cursor-not-allowed flex items-center justify-center gap-2"
      >
        <span id="btn-label">Encode Image</span>
        <span id="btn-spinner" class="hidden">
          <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
          </svg>
        </span>
      </button>

      <!-- Error Message -->
      <p id="error-msg" class="hidden text-red-400 text-sm text-center"></p>
    </div>

    <!-- Result Section -->
    <div id="result-section" class="hidden mt-10">
      <h2 class="text-xl font-bold mb-6" style="color: #00e5ff;">Watermark Embedded</h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-6">
        <div class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden">
          <p class="text-xs text-gray-500 uppercase tracking-wider px-4 py-2 border-b border-gray-800">
            Original
          </p>
          <div class="p-4">
            <img
              id="original-preview"
              src=""
              alt="Original image"
              class="w-full rounded-lg object-contain max-h-64"
            />
          </div>
        </div>
        <div class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden">
          <p class="text-xs font-medium px-4 py-2 border-b border-gray-800 uppercase tracking-wider" style="color: #00e5ff;">
            Watermarked
          </p>
          <div class="p-4">
            <img
              id="watermarked-preview"
              src=""
              alt="Watermarked image"
              class="w-full rounded-lg object-contain max-h-64"
            />
          </div>
        </div>
      </div>

      <a
        id="download-link"
        href="#"
        download="watermarked.png"
        class="inline-flex items-center gap-2 bg-[#00e5ff] text-gray-950 font-semibold hover:bg-cyan-300 rounded-lg px-6 py-3 transition-colors"
      >
        &#8675; Download Watermarked Image
      </a>
    </div>
  </div>
</Layout>

<script>
  const API_BASE = import.meta.env.PUBLIC_API_URL || 'https://spectraseal.onrender.com';

  // --- Elements ---
  const dropZone = document.getElementById('drop-zone') as HTMLDivElement;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const dropIdle = document.getElementById('drop-idle') as HTMLDivElement;
  const dropSelected = document.getElementById('drop-selected') as HTMLDivElement;
  const fileNameEl = document.getElementById('file-name') as HTMLParagraphElement;
  const labelInput = document.getElementById('label-input') as HTMLInputElement;
  const charCount = document.getElementById('char-count') as HTMLSpanElement;
  const encodeBtn = document.getElementById('encode-btn') as HTMLButtonElement;
  const btnLabel = document.getElementById('btn-label') as HTMLSpanElement;
  const btnSpinner = document.getElementById('btn-spinner') as HTMLSpanElement;
  const errorMsg = document.getElementById('error-msg') as HTMLParagraphElement;
  const usageText = document.getElementById('usage-text') as HTMLSpanElement;
  const usageBanner = document.getElementById('usage-banner') as HTMLDivElement;
  const limitBanner = document.getElementById('limit-banner') as HTMLDivElement;
  const limitResetText = document.getElementById('limit-reset-text') as HTMLParagraphElement;
  const resultSection = document.getElementById('result-section') as HTMLDivElement;
  const originalPreview = document.getElementById('original-preview') as HTMLImageElement;
  const watermarkedPreview = document.getElementById('watermarked-preview') as HTMLImageElement;
  const downloadLink = document.getElementById('download-link') as HTMLAnchorElement;
  const wakeupBanner = document.getElementById('wakeup-banner') as HTMLDivElement;

  let selectedFile: File | null = null;
  let limitReached = false;

  // --- Wake-up helper ---
  let serverAwake = false;
  function showWakeup() {
    if (!serverAwake) wakeupBanner.classList.remove('hidden');
  }
  function hideWakeup() {
    serverAwake = true;
    wakeupBanner.classList.add('hidden');
  }

  // --- Usage ---
  async function loadUsage() {
    const wakeTimer = setTimeout(showWakeup, 3000);
    try {
      const res = await fetch(`${API_BASE}/api/usage`);
      clearTimeout(wakeTimer);
      hideWakeup();
      if (!res.ok) throw new Error('Usage fetch failed');
      const data = await res.json() as { remaining: number; monthly_limit: number };
      usageText.textContent = `${data.remaining} of ${data.monthly_limit} remaining this month`;
      if (data.remaining <= 0) {
        limitReached = true;
        showLimitReached();
      } else if (data.remaining <= 2) {
        usageText.style.color = '#f59e0b'; // amber
      } else {
        usageText.style.color = '#00e5ff';
      }
    } catch {
      clearTimeout(wakeTimer);
      hideWakeup();
      usageText.textContent = 'Usage unavailable';
    }
    updateButtonState();
  }

  function showLimitReached(resetsAt?: string) {
    limitBanner.classList.remove('hidden');
    if (resetsAt) {
      const date = new Date(resetsAt);
      limitResetText.textContent = `Your 5 encodes for this month have been used. Resets ${date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}.`;
    }
  }

  // --- File Selection ---
  function setFile(file: File) {
    selectedFile = file;
    fileNameEl.textContent = file.name;
    dropIdle.classList.add('hidden');
    dropSelected.classList.remove('hidden');
    // Show original preview
    const url = URL.createObjectURL(file);
    originalPreview.src = url;
    updateButtonState();
  }

  dropZone.addEventListener('click', () => fileInput.click());

  dropZone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.classList.add('border-[#00e5ff]');
    dropZone.classList.remove('border-gray-700');
  });

  dropZone.addEventListener('dragleave', () => {
    dropZone.classList.remove('border-[#00e5ff]');
    dropZone.classList.add('border-gray-700');
  });

  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('border-[#00e5ff]');
    dropZone.classList.add('border-gray-700');
    const file = e.dataTransfer?.files?.[0];
    if (file && file.type.startsWith('image/')) {
      setFile(file);
    }
  });

  fileInput.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    if (file) setFile(file);
  });

  // --- Label Character Count ---
  labelInput.addEventListener('input', () => {
    charCount.textContent = `${labelInput.value.length} / 32`;
  });

  // --- Button State ---
  function updateButtonState() {
    const canSubmit = !!selectedFile && !limitReached;
    encodeBtn.disabled = !canSubmit;
    if (canSubmit) {
      encodeBtn.classList.remove('opacity-40', 'cursor-not-allowed');
    } else {
      encodeBtn.classList.add('opacity-40', 'cursor-not-allowed');
    }
  }

  // --- Submit ---
  encodeBtn.addEventListener('click', async () => {
    if (!selectedFile || limitReached) return;

    // Loading state
    encodeBtn.disabled = true;
    encodeBtn.classList.add('opacity-40', 'cursor-not-allowed');
    btnLabel.textContent = 'Encoding\u2026';
    btnSpinner.classList.remove('hidden');
    errorMsg.classList.add('hidden');
    resultSection.classList.add('hidden');

    const wakeTimer = setTimeout(showWakeup, 3000);
    try {
      const formData = new FormData();
      formData.append('image', selectedFile);
      formData.append('label', labelInput.value.trim() || 'Demo');

      const res = await fetch(`${API_BASE}/api/encode`, {
        method: 'POST',
        body: formData,
      });
      clearTimeout(wakeTimer);
      hideWakeup();

      if (res.status === 429) {
        const data = await res.json() as { error: string; remaining: number; resets_at: string };
        limitReached = true;
        showLimitReached(data.resets_at);
        usageText.textContent = `0 of 5 encodes remaining this month`;
        usageText.style.color = '#f59e0b';
        throw new Error(data.error || 'Monthly limit reached.');
      }

      if (res.status === 422) {
        const data = await res.json() as { error: string };
        throw new Error(data.error || 'Invalid image or request.');
      }

      if (!res.ok) {
        throw new Error(`Server error: ${res.status}`);
      }

      const blob = await res.blob();
      const url = URL.createObjectURL(blob);

      watermarkedPreview.src = url;
      downloadLink.href = url;
      downloadLink.download = `watermarked-${selectedFile.name.replace(/\.[^.]+$/, '')}.png`;

      resultSection.classList.remove('hidden');
      resultSection.scrollIntoView({ behavior: 'smooth', block: 'start' });

      // Refresh usage
      await loadUsage();
    } catch (err: unknown) {
      clearTimeout(wakeTimer);
      hideWakeup();
      const message = err instanceof Error ? err.message : 'An unexpected error occurred.';
      errorMsg.textContent = message;
      errorMsg.classList.remove('hidden');
    } finally {
      btnLabel.textContent = 'Encode Image';
      btnSpinner.classList.add('hidden');
      updateButtonState();
    }
  });

  // --- Init ---
  loadUsage();
</script>
